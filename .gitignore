# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment variables — NEVER commit secrets
.env
.env.local
.env.*.local

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Data — too big for Git, regenerated by our pipeline
data/raw/*
data/features/*
data/processed/*
!data/raw/.gitkeep
!data/features/.gitkeep
!data/processed/.gitkeep
!data/samples/

# MLflow local store (we use Postgres instead, but just in case)
mlruns/
mlflow.db

# Docker volumes (managed by docker-compose, not Git)
volumes/

# Logs
*.log
logs/

# OS
Thumbs.db
